{
  "name": "typed-notion-cli",
  "version": "1.0.0",
  "description": "CLI tool for generating type-safe TypeScript schemas from Notion data sources",
  "keywords": [
    "notion",
    "typescript",
    "cli",
    "schema",
    "codegen"
  ],
  "homepage": "https://github.com/satocchi0416sh/typed-notion-cli#readme",
  "bugs": {
    "url": "https://github.com/satocchi0416sh/typed-notion-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satocchi0416sh/typed-notion-cli.git"
  },
  "license": "MIT",
  "author": "satocchi0416sh",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typed-notion": "./bin/typed-notion.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:prod": "NODE_ENV=production tsup",
    "build:analyze": "tsup --metafile && npx esbuild-visualizer dist/metafile.json --metadata dist/meta.json",
    "bundle:size": "npm run build:prod && npx bundlesize",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "clean": "rimraf dist",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "prettier": "^3.1.1",
    "prompts": "^2.4.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.10.6",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^1.1.3"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
